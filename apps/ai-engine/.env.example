# ---------------------------------------------------------------------------
# apps/ai-engine — environment variables (example). Copy to `.env`.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# CORS — the Node API is the primary client
CORS_ORIGINS=http://localhost:4000

# Analysis risk defaults
DEFAULT_ATR_STOP_MULT=1.5
DEFAULT_RISK_REWARD=2.0

# Optional LLM providers (narrative explanations)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
