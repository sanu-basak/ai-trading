// ===========================================================================
// Backtesting — historical simulation runs, metrics, trades & equity curve.
// ===========================================================================

/// A single backtest execution over a strategy + universe + window.
model BacktestRun {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId     String
  strategy       Strategy       @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  name           String?
  status         BacktestStatus @default(QUEUED)
  timeframe      Timeframe
  startDate      DateTime
  endDate        DateTime
  initialCapital Decimal        @db.Decimal(20, 4)
  currency       String         @default("INR") @db.VarChar(3)
  /// Instrument universe (ids) + engine params (slippage, commission, sizing).
  params         Json           @default("{}")
  progress       Int            @default(0) // 0-100
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())

  result      BacktestResult?
  trades      BacktestTrade[]
  equityCurve EquityCurvePoint[]

  @@index([userId, status])
  @@index([strategyId])
  @@map("backtest_runs")
}

/// Aggregate performance metrics for a completed backtest.
model BacktestResult {
  id             String      @id @default(cuid())
  runId          String      @unique
  run            BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  totalReturn    Decimal     @db.Decimal(20, 4)
  totalReturnPct Decimal     @db.Decimal(12, 4)
  cagr           Decimal?    @db.Decimal(12, 4)
  winRate        Decimal     @db.Decimal(8, 4)
  profitFactor   Decimal?    @db.Decimal(12, 4)
  maxDrawdown    Decimal     @db.Decimal(12, 4)
  maxDrawdownPct Decimal     @db.Decimal(8, 4)
  sharpeRatio    Decimal?    @db.Decimal(12, 4)
  sortinoRatio   Decimal?    @db.Decimal(12, 4)
  calmarRatio    Decimal?    @db.Decimal(12, 4)
  avgRMultiple   Decimal?    @db.Decimal(12, 4)
  expectancy     Decimal?    @db.Decimal(20, 4)
  totalTrades    Int
  winningTrades  Int
  losingTrades   Int
  avgWin         Decimal?    @db.Decimal(20, 4)
  avgLoss        Decimal?    @db.Decimal(20, 4)
  largestWin     Decimal?    @db.Decimal(20, 4)
  largestLoss    Decimal?    @db.Decimal(20, 4)
  /// Extended metrics (monthly returns, exposure, streaks, etc.).
  metrics        Json        @default("{}")
  createdAt      DateTime    @default(now())

  @@map("backtest_results")
}

/// A single simulated trade produced by a backtest.
model BacktestTrade {
  id           String       @id @default(cuid())
  runId        String
  run          BacktestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  side         PositionSide
  quantity     Decimal      @db.Decimal(30, 8)
  entryAt      DateTime
  entryPrice   Decimal      @db.Decimal(20, 8)
  exitAt       DateTime?
  exitPrice    Decimal?     @db.Decimal(20, 8)
  pnl          Decimal?     @db.Decimal(20, 4)
  rMultiple    Decimal?     @db.Decimal(12, 4)
  exitReason   String?

  @@index([runId])
  @@index([instrumentId])
  @@map("backtest_trades")
}

/// A point on the backtest equity curve (for charting / drawdown).
model EquityCurvePoint {
  id          String      @id @default(cuid())
  runId       String
  run         BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  timestamp   DateTime
  equity      Decimal     @db.Decimal(20, 4)
  drawdownPct Decimal     @default(0) @db.Decimal(8, 4)

  @@unique([runId, timestamp])
  @@index([runId])
  @@map("equity_curve_points")
}
