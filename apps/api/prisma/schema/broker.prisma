// ===========================================================================
// Broker Integration — read-only/authorized connections to brokers.
// Tokens are encrypted at the application layer before persistence.
// ===========================================================================

/// A user's authorized connection to an external broker.
model BrokerConnection {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker         BrokerType
  status         BrokerConnectionStatus @default(PENDING)
  label          String?
  brokerUserId   String?
  accessToken    String? // encrypted
  refreshToken   String? // encrypted
  tokenExpiresAt DateTime?
  scopes         String[]
  metadata       Json?
  lastSyncedAt   DateTime?
  connectedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, broker, brokerUserId])
  @@index([userId])
  @@map("broker_connections")
}
