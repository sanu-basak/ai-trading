// ===========================================================================
// Risk Management — per-user risk profile driving position sizing & guards.
// ===========================================================================

/// A user's risk configuration used across sizing, alerts and AI guidance.
model RiskProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountSize         Decimal  @db.Decimal(20, 4)
  currency            String   @default("INR") @db.VarChar(3)
  maxRiskPerTradePct  Decimal  @default(1.0) @db.Decimal(6, 3)
  maxPortfolioRiskPct Decimal  @default(6.0) @db.Decimal(6, 3)
  maxOpenPositions    Int      @default(5)
  maxDailyLossPct     Decimal  @default(3.0) @db.Decimal(6, 3)
  maxDrawdownPct      Decimal  @default(20.0) @db.Decimal(6, 3)
  defaultRiskReward   Decimal  @default(2.0) @db.Decimal(6, 3)
  positionSizingModel String   @default("fixed_fractional") // fixed_fractional | fixed_amount | kelly | volatility
  riskParams          Json     @default("{}")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("risk_profiles")
}
