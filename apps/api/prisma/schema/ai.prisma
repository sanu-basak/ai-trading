// ===========================================================================
// AI Analysis, Signals, Vision, Chat & usage metering.
// Every signal is explainable: reasons + indicator snapshot are always stored.
// The platform never guarantees outcomes — NO_TRADE is a first-class result.
// ===========================================================================

/// A request to analyze an instrument (one or more timeframes).
model AnalysisRequest {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  type         AnalysisType   @default(FULL)
  timeframes   Timeframe[]
  status       AnalysisStatus @default(PENDING)
  params       Json           @default("{}")
  error        String?
  requestedAt  DateTime       @default(now())
  completedAt  DateTime?

  signals Signal[]

  @@index([userId, status])
  @@index([instrumentId])
  @@map("analysis_requests")
}

/// An explainable AI signal: BUY / SELL / NO_TRADE / WATCH.
model Signal {
  id           String           @id @default(cuid())
  requestId    String?
  request      AnalysisRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument       @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  type       SignalType
  timeframe  Timeframe
  confidence Decimal    @db.Decimal(5, 2) // 0-100

  entry         Decimal? @db.Decimal(20, 8)
  stopLoss      Decimal? @db.Decimal(20, 8)
  /// Ordered target levels: [{ price, rr, label }].
  targets       Json     @default("[]")
  riskReward    Decimal? @db.Decimal(12, 4)
  holdingPeriod String? // e.g. "intraday", "2-5 days", "swing"

  marketRegime MarketRegime?
  trend        TrendDirection?
  newsImpact   NewsImpact?

  /// Human-readable, structured rationale for the recommendation.
  reasons    Json    @default("[]") // [{ factor, weight, detail }]
  /// Snapshot of indicator values used (RSI, MACD, EMA, ADX, ATR, VWAP, …).
  indicators Json    @default("{}")
  /// Explicit reason(s) a trade was rejected (for NO_TRADE).
  rejection  Json?
  summary    String?

  modelVersion String?
  llmProvider  LlmProvider?
  generatedAt  DateTime     @default(now())
  expiresAt    DateTime?

  patterns PatternDetection[]
  levels   KeyLevel[]
  alerts   Alert[]            @relation("AlertSignal")

  @@index([userId, generatedAt])
  @@index([instrumentId, timeframe])
  @@index([type])
  @@map("signals")
}

/// A detected chart/candlestick/SMC/harmonic pattern tied to a signal.
model PatternDetection {
  id         String          @id @default(cuid())
  signalId   String
  signal     Signal          @relation(fields: [signalId], references: [id], onDelete: Cascade)
  category   PatternCategory
  name       String // e.g. "bullish_engulfing", "head_and_shoulders", "order_block"
  timeframe  Timeframe
  direction  TrendDirection?
  confidence Decimal         @db.Decimal(5, 2)
  /// Chart coordinates / anchor points for overlay rendering.
  geometry   Json?
  detail     String?

  @@index([signalId])
  @@map("pattern_detections")
}

/// A support/resistance/liquidity/pivot level tied to a signal.
model KeyLevel {
  id       String   @id @default(cuid())
  signalId String
  signal   Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  kind     String // "support" | "resistance" | "pivot" | "liquidity" | "fvg" | "order_block"
  price    Decimal  @db.Decimal(20, 8)
  priceTo  Decimal? @db.Decimal(20, 8) // for zones
  strength Decimal? @db.Decimal(5, 2)
  label    String?

  @@index([signalId])
  @@map("key_levels")
}

/// Analysis of a user-uploaded chart screenshot (AI vision).
model VisionAnalysis {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl     String
  status       AnalysisStatus @default(PENDING)
  signal       SignalType?
  confidence   Decimal?       @db.Decimal(5, 2)
  /// Detections: trend, candles, patterns, S/R, indicators, trade idea, risk.
  detections   Json           @default("{}")
  summary      String?
  modelVersion String?
  error        String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  @@index([userId, createdAt])
  @@map("vision_analyses")
}

/// An AI chat conversation (ChatGPT-like assistant).
model Conversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  model     String?
  provider  LlmProvider @default(ANTHROPIC)
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages ConversationMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

/// A single message within a conversation.
model ConversationMessage {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             AiRole
  content          String       @db.Text
  /// Tool calls / structured attachments (charts, analyses referenced).
  toolCalls        Json?
  promptTokens     Int?
  completionTokens Int?
  model            String?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// Metered record of an AI/LLM invocation (for quotas & cost tracking).
model AiUsageRecord {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature          AiFeature
  provider         LlmProvider
  model            String
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  costUsd          Decimal     @default(0) @db.Decimal(12, 6)
  latencyMs        Int?
  metadata         Json?
  createdAt        DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([feature])
  @@map("ai_usage_records")
}
