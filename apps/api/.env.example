# ---------------------------------------------------------------------------
# apps/api — environment variables (example)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=info

# --- HTTP / CORS / rate limiting ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Observability ---
METRICS_ENABLED=true
SWAGGER_ENABLED=true

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://devquantic:devquantic@localhost:5432/devquantic?schema=public"

# --- Redis (cache / pub-sub / BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth / security ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# --- AI service ---
AI_ENGINE_URL="http://localhost:8000"

# --- LLM providers ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Notifications ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DEVQUANTIC <no-reply@devquantic.ai>"
TELEGRAM_BOT_TOKEN=""

# --- Web push (VAPID) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@devquantic.ai"
