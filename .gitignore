# ---------------------------------------------------------------------------
# DEVQUANTIC AI TRADING ANALYST — root .gitignore
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/
**/node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
env/
.Python
pip-wheel-metadata/

# Build output
dist/
build/
out/
.next/
.vite/
*.tsbuildinfo
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
!infra/nginx/ssl/.gitkeep
secrets/
credentials/

# Machine-learning artifacts
apps/ai-engine/models_store/*
!apps/ai-engine/models_store/.gitkeep
*.ckpt
*.pt
*.pth
*.h5
*.onnx
*.joblib
*.pkl
mlruns/

# Prisma
apps/api/prisma/*.db
apps/api/prisma/dev.db*

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.DS_Store
Thumbs.db
*.swp

# Docker / infra local overrides
docker-compose.override.yml
infra/env/*.local

# Notebooks checkpoints
.ipynb_checkpoints/
